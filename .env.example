# Local data root. Defaults to ~/.openalice when omitted.
OPENALICE_HOME=.openalice-local

# OpenAI-compatible model connection. Keep the real key outside Git.
OPENALICE_MODEL_ALIAS=default
OPENALICE_MODEL_BASE_URL=https://api.openai.com/v1
OPENALICE_MODEL_NAME=gpt-4.1-mini
OPENALICE_MODEL_API_KEY=replace-with-local-secret
OPENALICE_MODEL_CONNECT_TIMEOUT=10s
OPENALICE_MODEL_READ_TIMEOUT=2m
