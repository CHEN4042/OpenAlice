<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>io.openalice</groupId>
  <artifactId>openalice-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>OpenAlice Parent</name>
  <description>A lifelong AI companion who never forgets.</description>

  <modules>
    <module>openalice-core</module>
    <module>openalice-memory</module>
    <module>openalice-agent</module>
    <module>openalice-server</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <agentscope.version>2.0.2</agentscope.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.agentscope</groupId>
        <artifactId>agentscope-bom</artifactId>
        <version>${agentscope.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.openalice</groupId>
        <artifactId>openalice-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.openalice</groupId>
        <artifactId>openalice-memory</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.openalice</groupId>
        <artifactId>openalice-agent</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
